{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Cloudflare 대시보드의 Worker 이름과 같아야 합니다.
  "name": "voca",
  "main": "src/index.js",
  "compatibility_date": "2026-09-20",
  "assets": {
    // public/ 폴더의 페이지·스크립트는 정적 파일로 바로 서비스하고,
    // /api/* 요청만 Worker(src/index.js)가 처리합니다.
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  // 대시보드(설정 → 변수 및 비밀)에 넣은 AI_API, FIREBASE_CONFIG 값이
  // 배포할 때 지워지지 않도록 유지합니다.
  "keep_vars": true,
  "observability": {
    "enabled": true
  }
}
