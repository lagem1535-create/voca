{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Cloudflare 대시보드의 Worker 이름과 같아야 Git 연동 배포가 됩니다.
  "name": "voca",
  "main": "src/index.js",
  "compatibility_date": "2026-09-20",
  "assets": {
    // public/ 은 정적 파일로 바로 서비스합니다.
    // /login, /words, /test/choice … 처럼 파일이 없는 경로는 index.html 을 돌려주고
    // 브라우저 라우터(public/js/router.js)가 기능별 페이지를 띄웁니다.
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // /api/* 만 Worker(src/index.js)가 처리합니다.
    "run_worker_first": ["/api/*"]
  },
  // 대시보드(설정 → 변수 및 비밀)에 넣은 AI_API, FIREBASE_CONFIG 가
  // 배포할 때 지워지지 않도록 유지합니다.
  "keep_vars": true,
  "observability": {
    "enabled": true
  }
}
